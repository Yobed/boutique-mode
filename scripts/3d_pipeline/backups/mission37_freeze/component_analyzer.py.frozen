    def synthesize_tableware_lathe_components(self, decision=None, target_metric_height=0.25):
        """
        Synthèse géométrique pour les solides de révolution (vases, carafes, bouteilles).
        Conserve le profil lathe lissé sans régression sur les objets de révolution.
        """
        if not self.base_analyzer.profile_radii:
            self.base_analyzer.extract_profile_contour()

        real_h = target_metric_height
        real_w = round(real_h / float(self.aspect_ratio), 4)
        r_max_metric = real_w / 2.0

        profile_points = []
        for r_norm, t in self.base_analyzer.profile_radii:
            r_m = max(0.012, r_norm * r_max_metric)
            z_m = t * real_h
            profile_points.append([round(r_m, 4), round(z_m, 4)])

        if not profile_points:
            profile_points = [
                [round(r_max_metric * 0.6, 4), 0.0],
                [round(r_max_metric, 4), round(real_h * 0.45, 4)],
                [round(r_max_metric * 0.45, 4), round(real_h * 0.85, 4)],
                [round(r_max_metric * 0.52, 4), round(real_h, 4)]
            ]

        pix = self.image.load()
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)
        colors = []
        for y in range(int(min_y + bh * 0.3), int(min_y + bh * 0.7)):
            for x in range(int(min_x + bw * 0.3), int(min_x + bw * 0.7)):
                if self.mask[y][x]:
                    colors.append(pix[x, y][:3])
        if colors:
            r_m = sum(c[0] for c in colors) / len(colors)
            g_m = sum(c[1] for c in colors) / len(colors)
            b_m = sum(c[2] for c in colors) / len(colors)
        else:
            r_m, g_m, b_m = 230, 228, 225

        materials_decl = {
            "M_Ceramique_Glazed": {
                "custom": {
                    "base_color": [round(r_m / 255.0, 3), round(g_m / 255.0, 3), round(b_m / 255.0, 3), 1.0],
                    "roughness": 0.12,
                    "metallic": 0.0,
                    "specular_ior_level": 0.55,
                    "coat_weight": 0.40,
                    "coat_roughness": 0.08
                }
            }
        }

        components = [
            {
                "id": "comp_1_corps_vase",
                "name": "Corps_Vase_Ceramique",
                "role": "main_lathe_body",
                "primitive": "lathe",
                "material": "M_Ceramique_Glazed",
                "segments": 40,
                "is_hollow": True,
                "wall_thickness": 0.004,
                "bevel_width": 0.001,
                "profile_points": profile_points,
                "location": [0.0, 0.0, 0.0],
                "geometric_inference": {
                    "primitive_chosen": "lathe",
                    "selection_rationale": "Solide de révolution axisymétrique déduit du profil courbé et de la symétrie > 0.85.",
                    "visual_cues": [f"Symétrie axiale {self.base_analyzer.symmetry_score:.3f}", f"{len(profile_points)} points d'échantillonnage de courbure"],
                    "confidence_level": 0.96
                }
            }
        ]

        base_stem = os.path.splitext(os.path.basename(self.image_path))[0]
        if "." in base_stem:
            base_stem = os.path.splitext(base_stem)[0]

        spec = {
            "object_id": f"{base_stem}_spatial_decomposed",
            "object_name": f"{base_stem.replace('_', ' ').title()} Solide Révolution",
            "category": "scandinavian_tableware_lathe",
            "scale_metric": {
                "unit": "meters",
                "dimensions": [round(real_w, 4), round(real_w, 4), round(real_h, 4)]
            },
            "coordinate_system": {
                "up_axis": "+Z",
                "forward_axis": "-Y",
                "lateral_axis": "+X",
                "origin": "bottom_center"
            },
            "materials": materials_decl,
            "components": components,
            "semantic_classification": decision,
            "analysis_metadata": {
                "source_image": self.image_path,
                "analyzer_module": "component_analyzer.py (Mission 36 Lathe Engine)",
                "detected_strata_count": 1,
                "total_components_generated": len(components),
                "confidence_score": decision.get("final_confidence", 0.96) if decision else 0.96,
                "contradiction_detected": decision.get("contradiction_detected", False) if decision else False,
                "known_facts": [
                    f"Dimensions boîte englobante 2D : {bw}x{bh} px",
                    f"Ratio d'aspect mesuré : {self.aspect_ratio:.3f}",
                    f"Symétrie bilatérale mesurée : {self.base_analyzer.symmetry_score:.3f}",
                    "Archétype identifié : Solide de révolution axisymétrique (Vase / Carafe)",
                    "Géométrie de révolution pure préservée sans régression"
                ],
                "indeterminate_elements": [
                    "Épaisseur de paroi interne estimée à 4mm, non mesurable directement sur photo 2D opaque."
                ],
                "hypotheses": [
                    "Révolution axiale complète 360° basée sur la stricte symétrie bilatérale.",
                    "Évidement intérieur débouchant au sommet avec collerette biseautée."
                ]
            }
        }
        return spec

    def synthesize_lamp_components(self, decision=None, target_metric_height=0.36):
        """
        Synthèse géométrique pour les luminaires / lampes de table à mât élancé.
        """
        real_h = target_metric_height
        real_w = round(real_h / float(self.aspect_ratio), 4)

        base_r = real_w * 0.40
        base_h = 0.015
        stem_h = real_h * 0.70
        stem_r = max(0.005, real_w * 0.03)
        shade_h = real_h * 0.42
        shade_r_bot = real_w * 0.48
        shade_r_top = real_w * 0.22
        shade_z = base_h + stem_h - shade_h * 0.65
        finial_h = 0.018
        finial_z = shade_z + shade_h

        pix = self.image.load()
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)
        colors = []
        for y in range(int(min_y + bh * 0.6), int(min_y + bh * 0.85)):
            for x in range(int(min_x + bw * 0.2), int(min_x + bw * 0.8)):
                if self.mask[y][x]:
                    colors.append(pix[x, y][:3])
        if colors:
            r_m = sum(c[0] for c in colors) / len(colors)
            g_m = sum(c[1] for c in colors) / len(colors)
            b_m = sum(c[2] for c in colors) / len(colors)
        else:
            r_m, g_m, b_m = 235, 235, 238

        materials_decl = {
            "M_Abat_Jour": {
                "custom": {
                    "base_color": [round(r_m / 255.0, 3), round(g_m / 255.0, 3), round(b_m / 255.0, 3), 1.0],
                    "roughness": 0.25,
                    "metallic": 0.0,
                    "specular_ior_level": 0.50
                }
            },
            "M_Metal_Structure": {
                "preset": "anodized_aluminum"
            }
        }

        components = [
            {
                "id": "comp_1_base_platine",
                "name": "Base_Platine",
                "role": "lamp_base_plinth",
                "primitive": "cylinder",
                "material": "M_Metal_Structure",
                "radius_top": round(base_r, 4),
                "radius_bottom": round(base_r, 4),
                "height": round(base_h, 4),
                "bevel_width": 0.0015,
                "segments": 36,
                "location": [0.0, 0.0, 0.0]
            },
            {
                "id": "comp_2_tige_centrale",
                "name": "Tige_Centrale",
                "role": "central_slender_rod",
                "primitive": "cylinder",
                "material": "M_Metal_Structure",
                "radius_top": round(stem_r, 4),
                "radius_bottom": round(stem_r, 4),
                "height": round(stem_h, 4),
                "bevel_width": 0.0005,
                "segments": 24,
                "location": [0.0, 0.0, round(base_h, 4)]
            },
            {
                "id": "comp_3_abat_jour",
                "name": "Abat_Jour_Conique",
                "role": "conical_lamp_shade",
                "primitive": "cylinder",
                "material": "M_Abat_Jour",
                "radius_top": round(shade_r_top, 4),
                "radius_bottom": round(shade_r_bot, 4),
                "height": round(shade_h, 4),
                "bevel_width": 0.002,
                "segments": 36,
                "location": [0.0, 0.0, round(shade_z, 4)]
            },
            {
                "id": "comp_4_finial",
                "name": "Finial_Sommital",
                "role": "top_finial_nut",
                "primitive": "cylinder",
                "material": "M_Metal_Structure",
                "radius_top": 0.010,
                "radius_bottom": 0.010,
                "height": round(finial_h, 4),
                "bevel_width": 0.001,
                "segments": 20,
                "location": [0.0, 0.0, round(finial_z, 4)]
            }
        ]

        base_stem = os.path.splitext(os.path.basename(self.image_path))[0]
        if "." in base_stem:
            base_stem = os.path.splitext(base_stem)[0]

        total_h = round(finial_z + finial_h, 4)
        spec = {
            "object_id": f"{base_stem}_spatial_decomposed",
            "object_name": f"{base_stem.replace('_', ' ').title()} Luminaire Minimaliste",
            "category": "minimalist_lighting",
            "scale_metric": {
                "unit": "meters",
                "dimensions": [round(real_w, 4), round(real_w, 4), total_h]
            },
            "coordinate_system": {
                "up_axis": "+Z",
                "forward_axis": "-Y",
                "lateral_axis": "+X",
                "origin": "bottom_center"
            },
            "materials": materials_decl,
            "components": components,
            "semantic_classification": decision,
            "analysis_metadata": {
                "source_image": self.image_path,
                "analyzer_module": "component_analyzer.py (Mission 36 Lighting Engine)",
                "detected_strata_count": 4,
                "total_components_generated": len(components),
                "confidence_score": decision.get("final_confidence", 0.95) if decision else 0.95,
                "contradiction_detected": decision.get("contradiction_detected", False) if decision else False,
                "known_facts": [
                    f"Dimensions boîte englobante 2D : {bw}x{bh} px",
                    f"Ratio d'aspect mesuré : {self.aspect_ratio:.3f}",
                    "Archétype identifié : Luminaire sur pied / Lampe de table à mât élancé"
                ],
                "indeterminate_elements": [
                    "Câblage interne et ampoule non modélisés."
                ],
                "hypotheses": [
                    "Symétrie axiale centrale à 360 degrés sur socle, tige et abat-jour."
                ]
            }
        }
        return spec

    def synthesize_electronics_components(self, decision=None, target_metric_height=0.125):
        """
        Synthèse géométrique pour les boîtiers électroniques prismatiques (SSD, batterie, hub).
        """
        real_h = target_metric_height
        real_w = round(real_h / float(self.aspect_ratio), 4)
        real_d = round(real_w * 0.22, 4)
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)

        materials_decl = {
            "M_Chassis_Alu": {
                "preset": "anodized_aluminum"
            },
            "M_Bumper_Silicone": {
                "preset": "matte_rubber"
            },
            "M_Accent_LED": {
                "preset": "emissive_led_ring"
            }
        }

        components = [
            {
                "id": "comp_1_chassis_alu",
                "name": "Chassis_Aluminium",
                "role": "internal_metal_core",
                "primitive": "rounded_box",
                "material": "M_Chassis_Alu",
                "dimensions": [round(real_w * 0.90, 4), round(real_d * 0.85, 4), round(real_h * 0.92, 4)],
                "corner_radius": 0.008,
                "taper_ratio": 1.0,
                "bevel_width": 0.0015,
                "location": [0.0, 0.0, round(real_h * 0.04, 4)]
            },
            {
                "id": "comp_2_bumper_silicone",
                "name": "Bumper_Protection_Silicone",
                "role": "outer_protective_casing",
                "primitive": "rounded_box",
                "material": "M_Bumper_Silicone",
                "dimensions": [round(real_w, 4), round(real_d, 4), round(real_h, 4)],
                "corner_radius": 0.012,
                "taper_ratio": 1.0,
                "bevel_width": 0.002,
                "location": [0.0, 0.0, 0.0]
            },
            {
                "id": "comp_3_led_indicator",
                "name": "LED_Indicateur_Status",
                "role": "status_indicator_led",
                "primitive": "cylinder",
                "material": "M_Accent_LED",
                "radius_top": 0.0035,
                "radius_bottom": 0.0035,
                "height": 0.002,
                "segments": 16,
                "location": [0.0, -round(real_d * 0.51, 4), round(real_h * 0.22, 4)],
                "rotation": [1.5708, 0.0, 0.0]
            },
            {
                "id": "comp_4_usbc_insert",
                "name": "Connecteur_USBC_Insert",
                "role": "io_connector_port",
                "primitive": "rounded_box",
                "material": "M_Bumper_Silicone",
                "dimensions": [0.014, 0.008, 0.006],
                "corner_radius": 0.002,
                "bevel_width": 0.0005,
                "location": [0.0, 0.0, -0.002]
            }
        ]

        base_stem = os.path.splitext(os.path.basename(self.image_path))[0]
        if "." in base_stem:
            base_stem = os.path.splitext(base_stem)[0]

        spec = {
            "object_id": f"{base_stem}_spatial_decomposed",
            "object_name": f"{base_stem.replace('_', ' ').title()} Boîtier Électronique",
            "category": "industrial_rugged_electronics",
            "scale_metric": {
                "unit": "meters",
                "dimensions": [round(real_w, 4), round(real_d * 1.107, 4), round(real_h + 0.002, 4)]
            },
            "coordinate_system": {
                "up_axis": "+Z",
                "forward_axis": "-Y",
                "lateral_axis": "+X",
                "origin": "bottom_center"
            },
            "materials": materials_decl,
            "components": components,
            "semantic_classification": decision,
            "analysis_metadata": {
                "source_image": self.image_path,
                "analyzer_module": "component_analyzer.py (Mission 36 Electronics Engine)",
                "detected_strata_count": 4,
                "total_components_generated": len(components),
                "confidence_score": decision.get("final_confidence", 0.95) if decision else 0.95,
                "contradiction_detected": decision.get("contradiction_detected", False) if decision else False,
                "known_facts": [
                    f"Dimensions boîte englobante 2D : {bw}x{bh} px",
                    f"Ratio d'aspect mesuré : {self.aspect_ratio:.3f}",
                    "Archétype identifié : Boîtier prismatique industriel / SSD"
                ],
                "indeterminate_elements": [
                    "Épaisseur Y front-to-back estimée selon les normes d'accessoires informatiques nomades."
                ],
                "hypotheses": [
                    "Structure bi-matière : châssis aluminium interne + surmoulage silicone protecteur."
                ]
            }
        }
        return spec

    def synthesize_components(self, target_metric_height=0.20):
        """
        Synthétise la liste déclarative des composants 3D en combinant
        classification sémantique prudente anti-contamination, les strates verticales,
        la décomposition transversale, l'inférence de révolution et la détection d'appendices.
        """
        # 1. Arbitrage sémantique prudent (Mission 36)
        decision = classify_product_semantics(
            self.image_path,
            self.mask,
            self.bbox,
            self.image.width,
            self.image.height,
            category_hint=self.category_hint,
            force_override=self.force_override
        )
        self.semantic_decision = decision
        final_cat = decision["final_category"]
        self.log(f"Arbitrage sémantique appliqué : '{final_cat}' (conf={decision['final_confidence']:.2f}, contra={decision['contradiction_detected']})")

        # 2. Routage vers l'archétype géométrique certifié sans contamination
        if final_cat == "fashion_handbag":
            return self.synthesize_fashion_leather_components(decision=decision, target_metric_height=target_metric_height)
        elif final_cat == "horizontal_lounge_furniture":
            return self.synthesize_horizontal_lounge_components(decision=decision, target_metric_height=0.85)
        elif final_cat == "tableware_lathe":
            return self.synthesize_tableware_lathe_components(decision=decision, target_metric_height=0.25)
        elif final_cat == "slender_pedestal_lamp":
            return self.synthesize_lamp_components(decision=decision, target_metric_height=0.36)
        elif final_cat == "prismatic_enclosure_electronics":
            return self.synthesize_electronics_components(decision=decision, target_metric_height=0.125)

        # 3. Repli universel sans préjugé sémantique (multi_component_spatial_decomposed)

        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)

        self.analyze_strata()
        features = self.detect_and_classify_features()

        real_h = target_metric_height
        real_w = real_h / float(self.aspect_ratio)
        real_d = real_w * 0.65  # Profondeur ergonomique standard

        # 1. Évaluation globale de symétrie et révolution sur le tronc principal
        global_sym = self.base_analyzer.symmetry_score
        raw_spans = []
        trunk_cxs = []
        for y in range(min_y, max_y + 1, 4):
            xs = [x for x in range(min_x, max_x + 1) if self.mask[y][x]]
            if xs:
                segs = []
                in_s = False
                s0 = 0
                for x in range(min(xs), max(xs) + 1):
                    if self.mask[y][x]:
                        if not in_s: in_s = True; s0 = x
                    else:
                        if in_s: segs.append((s0, x - 1)); in_s = False
                if in_s: segs.append((s0, max(xs)))
                clean = [s for s in segs if (s[1] - s[0] + 1) >= 4]
                if clean:
                    trunk = max(clean, key=lambda s: s[1] - s[0] + 1)
                    raw_spans.append(trunk[1] - trunk[0] + 1)
                    trunk_cxs.append((trunk[0] + trunk[1]) / 2.0)

        # Axe et symétrie du tronc principal (robuste face aux appendices asymétriques)
        if trunk_cxs:
            mean_axis = sum(trunk_cxs) / len(trunk_cxs)
            trunk_drift = max(abs(cx - mean_axis) for cx in trunk_cxs) / float(bw)
            trunk_sym = max(0.0, 1.0 - trunk_drift)
        else:
            trunk_sym = self.base_analyzer.symmetry_score

        bucket_size = max(10, int(bw * 0.05))
        hist = collections.Counter([s // bucket_size * bucket_size for s in raw_spans]) if raw_spans else {}
        dominant_count = hist.most_common(1)[0][1] if hist else 0
        peak_straight_ratio = dominant_count / float(len(raw_spans)) if raw_spans else 0.0

        # Un solide de révolution axisymétrique présente une symétrie de tronc élevée ET un profil organique/cylindrique.
        # Un objet dont > 72% des tranches ont une largeur identique caractérise une extrusion prismatique à parois droites (boîte, SSD, pavé).
        is_global_revolution = (trunk_sym > 0.85) and (peak_straight_ratio < 0.72) and (self.aspect_ratio > 0.65) and (self.aspect_ratio < 3.2)

        # Vérification si l'objet présente un contour très rectangulaire (boîte prismatique)
        fg_area = sum(sum(1 for v in row if v) for row in self.mask)
        rect_fill_ratio = fg_area / float(bw * bh)
        if rect_fill_ratio > 0.82:
            is_global_revolution = False

        self.log(f"Inférence globale : Symétrie tronc={trunk_sym:.2f}, Parois droites={peak_straight_ratio*100:.1f}%, Remplissage={rect_fill_ratio:.2f} -> Révolution: {is_global_revolution}")

        components = []
        materials_decl = {}
        prev_comp_id = None
        current_z = 0.0

        for idx, layer in enumerate(self.structural_layers):
            comp_h = max(0.005, layer["height_ratio"] * real_h)
            layer_offset_x = layer["relative_offset_x"] * real_w
            rel_w = layer["relative_width"]
            comp_w = max(0.008, rel_w * real_w)

            # CAS A : Strate décomposée en sous-composants latéraux
            if layer["lateral_components"]:
                self.log(f"Strate {idx} : Génération de {len(layer['lateral_components'])} composants latéraux distincts.")
                for c in layer["lateral_components"]:
                    sub_idx = c["cluster_idx"]
                    sub_offset_x = c["rel_cx"] * real_w
                    sub_w = max(0.010, c["rel_width"] * real_w)
                    sub_name = f"Element_Lateral_{idx+1}_{sub_idx+1}"

                    # Choix de la primitive selon l'élongation
                    aspect_col = comp_h / sub_w
                    if aspect_col > 1.2:
                        primitive = "cylinder"
                        radius = sub_w / 2.0
                        comp_def = {
                            "id": f"comp_{idx+1}_lat_{sub_idx+1}",
                            "name": sub_name,
                            "role": "lateral_columnar_element",
                            "primitive": "cylinder",
                            "radius_top": round(radius, 4),
                            "radius_bottom": round(radius, 4),
                            "height": round(comp_h, 4),
                            "segments": 24,
                            "bevel_width": 0.001,
                            "location": [round(sub_offset_x, 4), 0.0, round(current_z, 4)],
                            "confidence": 0.88,
                            "visual_justification": f"Colonne/rouleau latéral identifié par analyse spatiale transversale (rel_x={c['rel_cx']:+.3f}).",
                            "relationship": {"type": "lateral_array", "target": prev_comp_id}
                        }
                    else:
                        primitive = "rounded_box"
                        comp_def = {
                            "id": f"comp_{idx+1}_lat_{sub_idx+1}",
                            "name": sub_name,
                            "role": "lateral_sub_module",
                            "primitive": "rounded_box",
                            "dimensions": [round(sub_w, 4), round(real_d * 0.70, 4), round(comp_h, 4)],
                            "corner_radius": 0.010,
                            "taper_ratio": 1.0,
                            "bevel_width": 0.001,
                            "location": [round(sub_offset_x, 4), 0.0, round(current_z, 4)],
                            "confidence": 0.85,
                            "visual_justification": f"Sous-module latéral distinct identifié le long de X (rel_x={c['rel_cx']:+.3f}).",
                            "relationship": {"type": "lateral_array", "target": prev_comp_id}
                        }

                    # Matériau spécifique pour ce sous-composant
                    preset, custom = self.base_analyzer.map_color_to_pbr_preset(c["mean_rgb"])
                    mat_key = f"M_{sub_name}"
                    if preset:
                        materials_decl[mat_key] = {"preset": preset}
                    else:
                        materials_decl[mat_key] = {"custom": custom}
                    comp_def["material"] = mat_key
                    components.append(comp_def)

                prev_comp_id = components[-1]["id"]
                current_z += comp_h

            # CAS B : Strate monocomposant horizontale continue
            else:
                preset, custom = self.base_analyzer.map_color_to_pbr_preset(layer["mean_rgb"])

                # B.1 Détection de tige élancée continue
                if rel_w < 0.15 and comp_h > 0.015:
                    comp_name = f"Tige_Slender_Strate_{idx+1}"
                    radius = comp_w / 2.0
                    mat_key = f"M_{comp_name}"
                    materials_decl[mat_key] = {"preset": preset} if preset else {"custom": custom}

                    comp_entry = {
                        "id": f"comp_{idx+1}_stem",
                        "name": comp_name,
                        "role": "structural_slender_rod",
                        "primitive": "cylinder",
                        "material": mat_key,
                        "radius_top": round(radius, 4),
                        "radius_bottom": round(radius, 4),
                        "height": round(comp_h, 4),
                        "segments": 24,
                        "bevel_width": 0.0005,
                        "location": [round(layer_offset_x, 4), 0.0, round(current_z, 4)],
                        "relationship": {"type": "stacked_on" if prev_comp_id else "base_anchor", "target": prev_comp_id},
                        "geometric_inference": {
                            "primitive_chosen": "cylinder",
                            "selection_rationale": "Section très étroite continue assimilée à une tige/colonne cylindrique porteuse.",
                            "visual_cues": [f"Largeur relative faible (rel_w={rel_w:.3f} < 0.15)", "Symétrie bilatérale stricte"],
                            "confidence_level": 0.92,
                            "confidence_disclaimer": "Quantifie la clarté des indices 2D et non la conformité de faces cachées.",
                            "geometric_assumptions": ["Axe vertical cylindrique 360°", "Section circulaire uniforme"],
                            "indeterminate_elements": ["Section interne creuse ou pleine"]
                        }
                    }

                # B.2 Détection de solide de révolution
                elif is_global_revolution:
                    radius = comp_w / 2.0

                    # Vérifier si c'est une bague/collerette fine intercalaire
                    if comp_h < 0.016 and 0 < idx < len(self.structural_layers) - 1 and preset in ["natural_wood", "anodized_aluminum", "dark_polymer"]:
                        comp_name = f"Bague_Collier_Cerclage_{idx+1}"
                        r_ext = radius * 1.04
                        r_int = radius * 0.90
                        mat_key = f"M_{comp_name}"
                        materials_decl[mat_key] = {"preset": preset} if preset else {"custom": custom}

                        comp_entry = {
                            "id": f"comp_{idx+1}_ring",
                            "name": comp_name,
                            "role": "accent_collar_ring",
                            "primitive": "ring_collar",
                            "material": mat_key,
                            "radius_ext": round(r_ext, 4),
                            "radius_int": round(r_int, 4),
                            "height": round(comp_h, 4),
                            "segments": 32,
                            "bevel_width": 0.0004,
                            "location": [round(layer_offset_x, 4), 0.0, round(current_z, 4)],
                            "relationship": {"type": "stacked_on" if prev_comp_id else "base_anchor", "target": prev_comp_id},
                            "geometric_inference": {
                                "primitive_chosen": "ring_collar",
                                "selection_rationale": "Transition de col/ceinture à fort contraste matière sur un solide de révolution.",
                                "visual_cues": [f"Hauteur réduite ({comp_h:.3f}m)", f"Matériau contrastant ({preset})", "Symétrie axiale"],
                                "confidence_level": 0.89,
                                "confidence_disclaimer": "Quantifie la clarté des indices 2D et non la conformité de faces cachées.",
                                "geometric_assumptions": ["Cerclage annulaire 360°", "Ajusté au col"],
                                "indeterminate_elements": ["Épaisseur radiale intérieure non visible"]
                            }
                        }

                    else:
                        comp_name = f"Corps_Revolved_Strate_{idx+1}"
                        mat_key = f"M_{comp_name}"
                        materials_decl[mat_key] = {"preset": preset} if preset else {"custom": custom}

                        # Taper conique basé sur l'évolution de la strate
                        r_top = radius
                        r_bot = radius
                        if idx == len(self.structural_layers) - 1:
                            r_top = radius * 0.92
                        elif idx == 0:
                            r_bot = radius * 0.96

                        comp_entry = {
                            "id": f"comp_{idx+1}_revolved",
                            "name": comp_name,
                            "role": "revolved_body_segment",
                            "primitive": "cylinder",
                            "material": mat_key,
                            "radius_top": round(r_top, 4),
                            "radius_bottom": round(r_bot, 4),
                            "height": round(comp_h, 4),
                            "segments": 32,
                            "bevel_width": 0.001,
                            "location": [round(layer_offset_x, 4), 0.0, round(current_z, 4)],
                            "relationship": {"type": "stacked_on" if prev_comp_id else "base_anchor", "target": prev_comp_id},
                            "geometric_inference": {
                                "primitive_chosen": "cylinder",
                                "selection_rationale": "Strate d'un solide de révolution axisymétrique (symétrie bilatérale > 88% sans facettes planes).",
                                "visual_cues": [f"Symétrie globale={global_sym:.2f}", f"Rayon moyen={radius:.4f}m", "Continuité de courbure"],
                                "confidence_level": 0.91,
                                "confidence_disclaimer": "Quantifie la clarté des indices 2D et non la conformité de faces cachées.",
                                "geometric_assumptions": ["Symétrie de révolution 360° autour de Z", "Section circulaire"],
                                "indeterminate_elements": ["Forme de l'hémisphère arrière non visible"]
                            }
                        }

                # B.3 Forme prismatique standard (Boîte arrondie)
                else:
                    comp_d = max(0.010, rel_w * real_d)
                    if idx == 0:
                        role = "structural_base"
                        comp_name = "Socle_Inferieur"
                        cr = 0.015
                        taper = 0.98
                        justif = "Strate d'assise inférieure délimitée par la base de l'objet."
                    elif idx == len(self.structural_layers) - 1:
                        role = "top_cap_or_insert"
                        comp_name = "Chapeau_Superieur"
                        cr = 0.012
                        taper = 0.92
                        justif = "Strate sommitale fermant le volume supérieur."
                    elif layer["lum"] < 35.0:
                        role = "inter_module_plate"
                        comp_name = f"Platine_Separation_{idx+1}"
                        cr = 0.008
                        taper = 1.0
                        justif = "Bande intercalaire sombre délimitant les sous-systèmes mécaniques."
                    else:
                        role = "main_body_core"
                        comp_name = f"Corps_Principal_Strate_{idx+1}"
                        cr = 0.020
                        taper = 0.96
                        justif = "Strate continue constituant le bâti porteur prismatique."

                    mat_key = f"M_{comp_name}"
                    materials_decl[mat_key] = {"preset": preset} if preset else {"custom": custom}

                    comp_entry = {
                        "id": f"comp_{idx+1}_{comp_name.lower()}",
                        "name": comp_name,
                        "role": role,
                        "primitive": "rounded_box",
                        "material": mat_key,
                        "dimensions": [round(comp_w, 4), round(comp_d, 4), round(comp_h, 4)],
                        "location": [round(layer_offset_x, 4), 0.0, round(current_z, 4)],
                        "corner_radius": cr,
                        "taper_ratio": taper,
                        "bevel_width": 0.002,
                        "relationship": {"type": "stacked_on" if prev_comp_id else "base_anchor", "target": prev_comp_id},
                        "geometric_inference": {
                            "primitive_chosen": "rounded_box",
                            "selection_rationale": "Forme prismatique ou boîte industrielle ne présentant pas d'indices de révolution suffisants.",
                            "visual_cues": [f"Largeur={comp_w:.3f}m", f"Profondeur estimée={comp_d:.3f}m", f"Remplissage={rect_fill_ratio:.2f}"],
                            "confidence_level": 0.85,
                            "confidence_disclaimer": "Quantifie la clarté des indices 2D et non la conformité de faces cachées.",
                            "geometric_assumptions": ["Face avant observée, face arrière supposée plane/symétrique"],
                            "indeterminate_elements": ["Profondeur Y inférée par heuristique proportionnelle"]
                        }
                    }

                components.append(comp_entry)
                current_z += comp_h
                prev_comp_id = comp_entry["id"]

        # 2. Détection et ajout des appendices dépassants (anses, branches)
        detected_appendages = self.detect_appendages(real_w, real_h, current_z_base=0.0)
        for app_idx, app in enumerate(detected_appendages):
            app_mat_key = f"M_{app['name']}"
            preset, custom = self.base_analyzer.map_color_to_pbr_preset(app["mean_rgb"])
            materials_decl[app_mat_key] = {"preset": preset} if preset else {"custom": custom}

            components.append({
                "id": f"comp_appendage_{app_idx+1}",
                "name": app["name"],
                "role": app["role"],
                "primitive": app["primitive"],
                "material": app_mat_key,
                "path_points": app["path_points"],
                "radius": app["radius"],
                "segments": app["segments"],
                "location": [0.0, 0.0, 0.0],
                "relationship": {"type": "attached_to", "target": components[0]["id"]},
                "geometric_inference": {
                    "primitive_chosen": "curved_sweep",
                    "selection_rationale": app["rationale"],
                    "visual_cues": ["Vide traversant séparant la branche du tronc", "Continuité de trajectoire courbée"],
                    "confidence_level": app["confidence"],
                    "confidence_disclaimer": "Quantifie la clarté des indices 2D et non la conformité de faces cachées.",
                    "geometric_assumptions": app["assumptions"],
                    "indeterminate_elements": app["uncertainties"]
                }
            })

        # 3. Traitement des caractéristiques locales (discrimination prudente)
        confirmed_protrusions = [f for f in features if f.get("is_protrusion")]
        for f_idx, feat in enumerate(confirmed_protrusions):
            dial_r = feat["radius_rel"] * real_w
            mat_dial = "M_Dial_Accent"
            materials_decl[mat_dial] = {"preset": "dark_polymer"}
            components.append({
                "id": f"comp_detail_{f_idx+1}_cadran",
                "name": "Cadran_Circulaire_Accent",
                "role": "rotary_dial_bezel",
                "primitive": "ring_collar",
                "material": mat_dial,
                "radius_ext": round(dial_r, 4),
                "radius_int": round(dial_r * 0.80, 4),
                "height": 0.004,
                "bevel_width": 0.0004,
                "segments": 32,
                "location": [0.0, -round(real_d * 0.50, 4), round(real_h * 0.50, 4)],
                "rotation": [1.5708, 0.0, 0.0],
                "relationship": {"type": "embedded_in_face", "target": components[0]["id"]},
                "geometric_inference": {
                    "primitive_chosen": "ring_collar",
                    "selection_rationale": feat["justification"],
                    "visual_cues": [f"Contraste={feat.get('contrast', 0):.1f}", "Gradient haut/bas validé"],
                    "confidence_level": 0.78,
                    "confidence_disclaimer": "Quantifie la clarté des indices 2D et non la conformité de faces cachées.",
                    "geometric_assumptions": ["Bouton ou cadran circulaire en saillie"],
                    "indeterminate_elements": ["Course mécanique ou profondeur d'encastrement"]
                }
            })

        # Dimensions englobantes maximales
        max_comp_w = 0.010
        max_comp_d = 0.010
        for c in components:
            if "dimensions" in c:
                max_comp_w = max(max_comp_w, c["dimensions"][0])
                max_comp_d = max(max_comp_d, c["dimensions"][1])
            elif "radius_top" in c:
                r = max(c.get("radius_top", 0), c.get("radius_bottom", 0))
                max_comp_w = max(max_comp_w, r * 2.0)
                max_comp_d = max(max_comp_d, r * 2.0)
            elif "radius_ext" in c:
                r = c.get("radius_ext", 0)
                max_comp_w = max(max_comp_w, r * 2.0)
                max_comp_d = max(max_comp_d, r * 2.0)
            elif "path_points" in c:
                xs = [abs(p[0]) for p in c["path_points"]]
                if xs:
                    max_comp_w = max(max_comp_w, max(xs) * 2.0)

        total_scale = [round(max_comp_w, 4), round(max_comp_d, 4), round(current_z, 4)]

        base_stem = os.path.splitext(os.path.basename(self.image_path))[0]
        if "." in base_stem:
            base_stem = os.path.splitext(base_stem)[0]

        spec = {
            "object_id": f"{base_stem}_spatial_decomposed",
            "object_name": f"{base_stem.replace('_', ' ').title()} Enhanced Spatial Model",
            "category": "multi_component_spatial_decomposed",
            "scale_metric": {
                "unit": "meters",
                "dimensions": total_scale
            },
            "coordinate_system": {
                "up_axis": "+Z",
                "forward_axis": "-Y",
                "lateral_axis": "+X",
                "origin": "bottom_center"
            },
            "materials": materials_decl,
            "components": components,
            "analysis_metadata": {
                "source_image": self.image_path,
                "analyzer_module": "component_analyzer.py (Mission 32 Geometric Inference Engine)",
                "detected_strata_count": len(self.structural_layers),
                "total_components_generated": len(components),
                "feature_analysis": features,
                "confidence_score": 0.91,
                "monocular_ambiguity": True,
                "spatial_decomposition_enabled": True,
                "geometric_inference_enabled": True,
                "revolution_profile_detected": is_global_revolution,
                "appendages_detected_count": len(detected_appendages),
                "known_facts": [
                    f"Dimensions boîte englobante 2D : {bw}x{bh} px",
                    f"Ratio d'aspect mesuré : {self.aspect_ratio:.3f}",
                    f"Symétrie bilatérale mesurée : {self.base_analyzer.symmetry_score:.3f}",
                    f"Nombre de strates physiques distinctes : {len(self.structural_layers)}"
                ],
                "hypotheses": [
                    "Décomposition spatiale bidimensionnelle (strates verticales + clusters latéraux transversaux).",
                    "Inférence automatique de profil de révolution (Cylinder/RingCollar) basée sur la symétrie axiale.",
                    "Détection d'appendices en arceau/anse (CurvedSweep) via suivi des segments satellites traversants.",
                    "Discrimination physique cavité vs saillie : omission de bouton saillant si luminance interne sombre ou gradient non probant."
                ]
            },
            "semantic_classification": getattr(self, "semantic_decision", None)
        }
        return spec


def main():
    if len(sys.argv) < 3:
        print("Usage: python component_analyzer.py --image <image_path> --output <spec_path> [--category <cat>] [--force-category]")
        sys.exit(1)

    image_path = None
    output_path = None
    category = None
    force_override = False
    for i in range(len(sys.argv)):
        if sys.argv[i] == "--image" and i + 1 < len(sys.argv):
            image_path = sys.argv[i + 1]
        elif sys.argv[i] == "--output" and i + 1 < len(sys.argv):
            output_path = sys.argv[i + 1]
        elif sys.argv[i] == "--category" and i + 1 < len(sys.argv):
            category = sys.argv[i + 1]
        elif sys.argv[i] in ["--force-category", "--force"]:
            force_override = True

    if not image_path or not output_path:
        print("Erreur : --image et --output sont requis.")
        sys.exit(1)

    import json
    decomposer = VisualComponentDecomposer(image_path, category_hint=category, force_override=force_override)
    spec = decomposer.synthesize_components()

    os.makedirs(os.path.dirname(os.path.abspath(output_path)), exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(spec, f, indent=2)

    print(f"Spécification spatiale générée avec succès : {output_path}")
    print(f"  - Catégorie certifiée : {spec['category']}")
    print(f"  - Composants détectés : {len(spec['components'])}")
    print(f"  - Matériaux physiques : {len(spec['materials'])}")
    if spec.get("semantic_classification"):
        sc = spec["semantic_classification"]
        print(f"  - Contradiction détectée : {sc.get('contradiction_detected', False)}")
        print(f"  - Confiance décisionnelle : {sc.get('final_confidence', 0.0)}")


if __name__ == "__main__":
    main()
