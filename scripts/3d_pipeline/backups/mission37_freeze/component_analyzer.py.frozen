"""
component_analyzer.py — Décomposition Visuelle Spatiale et Inférence Géométrique Automatique
Fait partie intégrante du pipeline procédural générique Image-to-3D pour Blender 5.x.

Améliorations Mission 30B & 32 :
- Décomposition spatiale bidimensionnelle (analyse verticale Z + analyse transversale X)
- Détection des profils de révolution (Axisymétrie, Cylinder, Lathe, RingCollar)
- Détection générique des appendices et branches dépassantes (CurvedSweep)
- Continuité structurelle des tiges élancées (fusion de colonnes)
- Sélection de primitives et traçabilité des incertitudes monoculaires
- Discrimination physique prudente entre cavités/ouvertures sombres et éléments en saillie
- Zéro faux positif de boutons/cadrans sur les reflets ou ouvertures
"""

import collections
import math
import os
import sys
from PIL import Image

PIPELINE_DIR = os.path.dirname(os.path.abspath(__file__))
if PIPELINE_DIR not in sys.path:
    sys.path.append(PIPELINE_DIR)

from image_analyzer import ReferenceImageAnalyzer
from semantic_classifier import classify_product_semantics


class VisualComponentDecomposer:
    """
    Décomposeur structurel de premier plan en composants physiques assemblables.
    Combine stratification verticale, inférence de révolution, détection d'appendices
    et sélection raisonnée de primitives 3D.
    """

    def __init__(self, image_path, category_hint=None, force_override=False):
        self.image_path = os.path.abspath(image_path)
        if not os.path.exists(self.image_path):
            raise FileNotFoundError(f"Image introuvable : {self.image_path}")

        self.category_hint = category_hint
        self.force_override = force_override
        # Utiliser l'analyseur de base pour la vision initiale
        self.base_analyzer = ReferenceImageAnalyzer(self.image_path, category_hint=category_hint)
        self.base_analyzer.segment_foreground()
        self.base_analyzer.compute_symmetry()
        self.base_analyzer.extract_dominant_colors(max_colors=4)

        self.image = self.base_analyzer.raw_image
        self.mask = self.base_analyzer.mask
        self.bbox = self.base_analyzer.bbox  # min_x, min_y, max_x, max_y
        self.palette = self.base_analyzer.palette
        self.aspect_ratio = self.base_analyzer.aspect_ratio

        self.components = []
        self.structural_layers = []
        self.analysis_logs = []
        self.detected_features = []

    def log(self, msg):
        self.analysis_logs.append(msg)

    def analyze_strata(self, num_slices=48):
        """
        Découpe l'objet en tranches horizontales fines et analyse le profil spatial,
        les discontinuités géométriques, le vide interne et les contrastes de matière.
        """
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)
        pix = self.image.load()

        slices = []
        for i in range(num_slices):
            # De la base (y_max) au sommet (y_min)
            t = i / float(num_slices - 1)
            y = int(max_y - t * bh)
            y = min(max(y, 0), self.image.height - 1)

            xs = [x for x in range(min_x, max_x + 1) if self.mask[y][x]]
            if not xs:
                continue

            lx, rx = min(xs), max(xs)
            span_w = rx - lx + 1
            solid_w = len(xs)
            void_ratio = 1.0 - (solid_w / float(span_w))
            cx = (lx + rx) / 2.0

            colors = [pix[x, y] for x in xs]
            avg_r = sum(c[0] for c in colors) / len(colors)
            avg_g = sum(c[1] for c in colors) / len(colors)
            avg_b = sum(c[2] for c in colors) / len(colors)
            lum = 0.299 * avg_r + 0.587 * avg_g + 0.114 * avg_b

            # Détection des segments connectés le long de X sur cette ligne
            segments = []
            in_seg = False
            s_start = 0
            for x in range(lx, rx + 1):
                if self.mask[y][x]:
                    if not in_seg:
                        in_seg = True
                        s_start = x
                else:
                    if in_seg:
                        segments.append((s_start, x - 1))
                        in_seg = False
            if in_seg:
                segments.append((s_start, rx))

            # Filtrer les bruits parasites (< 2.5% de bw)
            min_seg_w = max(4, int(bw * 0.025))
            clean_segs = [s for s in segments if (s[1] - s[0] + 1) >= min_seg_w]

            slices.append({
                "idx": i,
                "t": t,
                "y": y,
                "span_w": span_w,
                "solid_w": solid_w,
                "void_ratio": void_ratio,
                "cx": cx,
                "avg_rgb": (avg_r, avg_g, avg_b),
                "lum": lum,
                "segments": clean_segs
            })

        if not slices:
            return []

        # Détection des frontières physiques entre strates
        cut_indices = []
        for j in range(1, len(slices)):
            s_prev = slices[j - 1]
            s_curr = slices[j]

            # Écart colorimétrique et luminance
            dr = s_curr["avg_rgb"][0] - s_prev["avg_rgb"][0]
            dg = s_curr["avg_rgb"][1] - s_prev["avg_rgb"][1]
            db = s_curr["avg_rgb"][2] - s_prev["avg_rgb"][2]
            color_dist = math.sqrt(dr * dr + dg * dg + db * db)
            lum_delta = abs(s_curr["lum"] - s_prev["lum"])

            # Écarts géométriques et topologiques
            span_delta = abs(s_curr["span_w"] - s_prev["span_w"]) / float(bw)
            solid_delta = abs(s_curr["solid_w"] - s_prev["solid_w"]) / float(bw)
            void_delta = abs(s_curr["void_ratio"] - s_prev["void_ratio"])
            seg_count_delta = abs(len(s_curr["segments"]) - len(s_prev["segments"]))
            center_shift = abs(s_curr["cx"] - s_prev["cx"]) / float(bw)

            is_cut = False
            reasons = []

            # 1. Épaulement géométrique franc
            if span_delta > 0.14 or solid_delta > 0.16:
                is_cut = True
                reasons.append(f"geometric_step(span_d={span_delta:.2f}, solid_d={solid_delta:.2f})")

            # 2. Rupture topologique transversale (apparition de colonnes / vides internes)
            elif seg_count_delta >= 2 or (void_delta > 0.22 and (s_curr["void_ratio"] > 0.15 or s_prev["void_ratio"] > 0.15)):
                is_cut = True
                reasons.append(f"transverse_topology_change(segs={len(s_prev['segments'])}->{len(s_curr['segments'])}, void_d={void_delta:.2f})")

            # 3. Transition franche de matériau (changement de teinte/luminance)
            elif (color_dist > 45.0 or lum_delta > 35.0) and (s_curr["t"] < 0.15 or s_curr["t"] > 0.65 or span_delta > 0.04):
                is_cut = True
                reasons.append(f"material_transition(dist={color_dist:.1f}, dL={lum_delta:.1f})")

            elif center_shift > 0.12 and span_delta > 0.04:
                is_cut = True
                reasons.append(f"lateral_axis_offset(shift={center_shift:.2f})")

            if is_cut:
                cut_indices.append((j, reasons))

        # Regroupement des tranches en couches continues
        cut_points = [0] + [c[0] for c in cut_indices] + [len(slices)]
        cut_points = sorted(list(set(cut_points)))

        # Fusion des strates trop minces (< 2 tranches sauf si saut de couleur très net ou base/sommet)
        merged_ranges = []
        curr_start = cut_points[0]
        for cp in cut_points[1:]:
            count = cp - curr_start
            if count >= 2 or curr_start == 0 or cp == len(slices):
                merged_ranges.append((curr_start, cp))
                curr_start = cp
            else:
                if merged_ranges:
                    prev_s, _ = merged_ranges.pop()
                    merged_ranges.append((prev_s, cp))
                    curr_start = cp
                else:
                    merged_ranges.append((curr_start, cp))
                    curr_start = cp

        layers = []
        for idx, (r_start, r_end) in enumerate(merged_ranges):
            layer_slices = slices[r_start:r_end]
            if not layer_slices:
                continue

            t_min = layer_slices[0]["t"]
            t_max = layer_slices[-1]["t"]
            h_ratio = len(layer_slices) / float(len(slices))

            avg_span_w = sum(s["span_w"] for s in layer_slices) / len(layer_slices)
            avg_solid_w = sum(s["solid_w"] for s in layer_slices) / len(layer_slices)
            avg_void = sum(s["void_ratio"] for s in layer_slices) / len(layer_slices)
            avg_cx = sum(s["cx"] for s in layer_slices) / len(layer_slices)

            r_m = sum(s["avg_rgb"][0] for s in layer_slices) / len(layer_slices)
            g_m = sum(s["avg_rgb"][1] for s in layer_slices) / len(layer_slices)
            b_m = sum(s["avg_rgb"][2] for s in layer_slices) / len(layer_slices)
            lum_m = sum(s["lum"] for s in layer_slices) / len(layer_slices)

            # Analyse transversale : détection de sous-composants latéraux distincts
            slice_segs_counts = [len(s["segments"]) for s in layer_slices]
            median_segs = sorted(slice_segs_counts)[len(slice_segs_counts) // 2]

            lateral_clusters = []
            if median_segs >= 2 or avg_void > 0.20:
                all_segs = []
                for s in layer_slices:
                    all_segs.extend(s["segments"])

                # Clustering 1D le long de X selon la position centrale
                clusters = []
                for (s0, s1) in all_segs:
                    scx = (s0 + s1) / 2.0
                    sw = s1 - s0 + 1
                    matched = False
                    for c in clusters:
                        if abs(scx - c["cx"]) < bw * 0.12:
                            c["samples"].append((scx, sw, s0, s1))
                            c["cx"] = sum(p[0] for p in c["samples"]) / len(c["samples"])
                            matched = True
                            break
                    if not matched:
                        clusters.append({"cx": scx, "samples": [(scx, sw, s0, s1)]})

                min_presence = max(2, int(len(layer_slices) * 0.35))
                valid_c = [c for c in clusters if len(c["samples"]) >= min_presence]
                valid_c = sorted(valid_c, key=lambda c: c["cx"])

                if len(valid_c) >= 2:
                    for c_idx, c in enumerate(valid_c):
                        avg_cw = sum(p[1] for p in c["samples"]) / len(c["samples"])
                        rel_cx = (c["cx"] - (min_x + bw / 2.0)) / float(bw)
                        rel_cw = avg_cw / float(bw)

                        # Échantillonnage de la couleur du cluster
                        clust_colors = []
                        for s in layer_slices:
                            y_curr = s["y"]
                            for p in c["samples"]:
                                s0, s1 = p[2], p[3]
                                for x_sample in range(max(min_x, s0), min(max_x + 1, s1 + 1), 2):
                                    if self.mask[y_curr][x_sample]:
                                        clust_colors.append(pix[x_sample, y_curr])
                        if clust_colors:
                            c_r = sum(col[0] for col in clust_colors) / len(clust_colors)
                            c_g = sum(col[1] for col in clust_colors) / len(clust_colors)
                            c_b = sum(col[2] for col in clust_colors) / len(clust_colors)
                        else:
                            c_r, c_g, c_b = r_m, g_m, b_m

                        lateral_clusters.append({
                            "cluster_idx": c_idx,
                            "rel_cx": rel_cx,
                            "rel_width": rel_cw,
                            "mean_rgb": (int(c_r), int(c_g), int(c_b)),
                            "presence": len(c["samples"]) / float(len(layer_slices))
                        })

            layers.append({
                "idx": idx,
                "start_t": t_min,
                "end_t": t_max,
                "height_ratio": h_ratio,
                "span_w": avg_span_w,
                "solid_w": avg_solid_w,
                "void_ratio": avg_void,
                "relative_width": avg_span_w / float(bw),
                "relative_offset_x": (avg_cx - (min_x + bw / 2.0)) / float(bw),
                "mean_rgb": (int(r_m), int(g_m), int(b_m)),
                "lum": lum_m,
                "slice_count": len(layer_slices),
                "lateral_components": lateral_clusters
            })

        self.structural_layers = layers
        self.log(f"Strates physiques détectées : {len(layers)}")
        return layers

    def detect_and_classify_features(self):
        """
        Recherche les éléments circulaires et discrimine physiquement les cavités/ouvertures
        des véritables saillies en relief via analyse multi-secteurs et gradient lumineux.
        """
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)
        pix = self.image.load()

        cx_obj = min_x + bw / 2.0
        cy_obj = min_y + bh / 2.0

        features = []
        for r_cand in [bw * 0.12, bw * 0.18, bw * 0.25]:
            # 1. Vérification de cohérence circulaire sur 8 secteurs angulaires
            sector_diffs = []
            num_sectors = 8
            for sec in range(num_sectors):
                th = (2.0 * math.pi / num_sectors) * sec
                px_in = int(cx_obj + (r_cand - 6) * math.cos(th))
                py_in = int(cy_obj + (r_cand - 6) * math.sin(th))
                px_out = int(cx_obj + (r_cand + 6) * math.cos(th))
                py_out = int(cy_obj + (r_cand + 6) * math.sin(th))

                if (0 <= px_in < self.image.width and 0 <= py_in < self.image.height and
                        0 <= px_out < self.image.width and 0 <= py_out < self.image.height):
                    cin = pix[px_in, py_in]
                    cout = pix[px_out, py_out]
                    diff = math.sqrt((cin[0] - cout[0]) ** 2 + (cin[1] - cout[1]) ** 2 + (cin[2] - cout[2]) ** 2)
                    sector_diffs.append(diff)
                else:
                    sector_diffs.append(0.0)

            active_sectors = [d for d in sector_diffs if d > 20.0]
            # Si le contour circulaire n'est pas présent sur au moins 6 secteurs sur 8, ce n'est pas un disque autonome
            if len(active_sectors) < 6:
                continue

            # 2. Mesure de luminance intérieure
            in_lums = []
            for dy in range(int(-r_cand * 0.6), int(r_cand * 0.6) + 1):
                for dx in range(int(-r_cand * 0.6), int(r_cand * 0.6) + 1):
                    if dx * dx + dy * dy <= (r_cand * 0.6) ** 2:
                        px, py = int(cx_obj + dx), int(cy_obj + dy)
                        if 0 <= px < self.image.width and 0 <= py < self.image.height and self.mask[py][px]:
                            c = pix[px, py]
                            in_lums.append(0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2])

            # 3. Mesure du pourtour et du gradient haut/bas (recherche de reflet spéculaire haut et ombre basse)
            top_rim_lums, bot_rim_lums = [], []
            for s in range(24):
                th = 2.0 * math.pi * (s / 24)
                px = int(cx_obj + r_cand * math.cos(th))
                py = int(cy_obj + r_cand * math.sin(th))
                if 0 <= px < self.image.width and 0 <= py < self.image.height and self.mask[py][px]:
                    c = pix[px, py]
                    lum = 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]
                    if math.sin(th) < -0.3:
                        top_rim_lums.append(lum)
                    elif math.sin(th) > 0.3:
                        bot_rim_lums.append(lum)

            # 4. Mesure du corps porteur environnant
            body_lums = []
            for s in range(24):
                th = 2.0 * math.pi * (s / 24)
                px = int(cx_obj + 1.5 * r_cand * math.cos(th))
                py = int(cy_obj + 1.5 * r_cand * math.sin(th))
                if 0 <= px < self.image.width and 0 <= py < self.image.height and self.mask[py][px]:
                    c = pix[px, py]
                    body_lums.append(0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2])

            if not in_lums or not body_lums:
                continue

            avg_in = sum(in_lums) / len(in_lums)
            avg_body = sum(body_lums) / len(body_lums)
            avg_top = sum(top_rim_lums) / len(top_rim_lums) if top_rim_lums else avg_body
            avg_bot = sum(bot_rim_lums) / len(bot_rim_lums) if bot_rim_lums else avg_body
            contrast = abs(avg_in - avg_body)

            if contrast > 25.0:
                # CAS 1 : Cavité ou ouverture sombre (l'intérieur piège la lumière)
                if avg_in < avg_body - 20:
                    features.append({
                        "type": "cavity_or_aperture",
                        "radius_rel": r_cand / float(bw),
                        "contrast": round(contrast, 2),
                        "inside_lum": round(avg_in, 1),
                        "body_lum": round(avg_body, 1),
                        "is_protrusion": False,
                        "justification": f"Luminance interne sombre ({avg_in:.1f} vs {avg_body:.1f}) : cavité/ouverture interne, omission stricte d'un bouton saillant."
                    })
                    break

                # CAS 2 : Véritable saillie avec surbrillance supérieure et ombre inférieure
                elif avg_top > avg_bot + 15 and avg_in >= avg_body - 10:
                    features.append({
                        "type": "rotary_dial_or_bezel",
                        "radius_rel": r_cand / float(bw),
                        "contrast": round(contrast, 2),
                        "is_protrusion": True,
                        "justification": f"Contraste net avec surbrillance supérieure et ombre portée ({avg_top:.1f} vs {avg_bot:.1f}) : relief saillant confirmé."
                    })
                    break

                # CAS 3 : Motif ambigu ou reflet interne dans un milieu transparent
                else:
                    features.append({
                        "type": "ambiguous_monocular_feature",
                        "radius_rel": r_cand / float(bw),
                        "contrast": round(contrast, 2),
                        "is_protrusion": False,
                        "justification": f"Contraste mesuré ({contrast:.1f}) sans preuve physique de saillie : incertitude monoculaire documentée, omission prudente de bouton saillant."
                    })
                    break

        self.detected_features = features
        return features

    def detect_appendages(self, real_w, real_h, current_z_base=0.0):
        """
        Détecte génériquement les branches, anses et appendices dépassant du tronc principal.
        Utilise les segments satellites déconnectés par un intervalle de fond traversant.
        """
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)
        pix = self.image.load()

        trunk_axis = min_x + bw / 2.0
        sat_points = []
        for step in range(36):
            t = step / 35.0
            y = int(max_y - t * (bh - 1))
            xs = [x for x in range(min_x, max_x + 1) if self.mask[y][x]]
            if not xs:
                continue

            segs = []
            in_s = False
            s_start = 0
            for x in range(min_x, max_x + 1):
                if self.mask[y][x]:
                    if not in_s:
                        in_s = True
                        s_start = x
                else:
                    if in_s:
                        segs.append((s_start, x - 1))
                        in_s = False
            if in_s:
                segs.append((s_start, max_x))

            clean = [s for s in segs if (s[1] - s[0] + 1) >= 4]
            if len(clean) >= 2:
                trunk = max(clean, key=lambda s: (s[1] - s[0] + 1) / (1.0 + abs((s[0]+s[1])/2.0 - trunk_axis)*0.05))
                for sat in clean:
                    if sat != trunk:
                        sat_cx = (sat[0] + sat[1]) / 2.0
                        sat_w = sat[1] - sat[0] + 1
                        sat_points.append({
                            "y": y,
                            "t": t,
                            "cx": sat_cx,
                            "w": sat_w,
                            "seg": sat,
                            "is_left": sat_cx < trunk_axis
                        })

        appendages = []
        for side, pts in [("gauche", [p for p in sat_points if p["is_left"]]),
                          ("droite", [p for p in sat_points if not p["is_left"]])]:
            if len(pts) >= 6:
                ys = [p["y"] for p in pts]
                y_span = max(ys) - min(ys)
                if y_span > bh * 0.18:
                    p_top = min(pts, key=lambda p: p["y"])
                    p_bot = max(pts, key=lambda p: p["y"])
                    mid_pts = [p for p in pts if p["y"] > p_top["y"] + y_span*0.25 and p["y"] < p_bot["y"] - y_span*0.25]
                    bulge = 0.0
                    if mid_pts:
                        avg_mid_cx = sum(p["cx"] for p in mid_pts) / len(mid_pts)
                        chord_cx = (p_top["cx"] + p_bot["cx"]) / 2.0
                        bulge = abs(avg_mid_cx - chord_cx)

                    if bulge > 3.0:
                        sorted_pts = sorted(pts, key=lambda p: p["t"])
                        step_idx = len(sorted_pts) / 6.0
                        sample_pts = [sorted_pts[int(i * step_idx)] for i in range(6)] + [sorted_pts[-1]]

                        path_3d = []
                        for sp in sample_pts:
                            px_rel = (sp["cx"] - (min_x + bw / 2.0)) / float(bw)
                            x_m = px_rel * real_w
                            z_m = current_z_base + sp["t"] * real_h
                            path_3d.append([round(x_m, 4), 0.0, round(z_m, 4)])

                        mean_w = sum(p["w"] for p in pts) / len(pts)
                        tube_rad = max(0.003, min(0.015, (mean_w / float(bw)) * real_w * 0.5))

                        cols = []
                        for sp in sample_pts:
                            py = sp["y"]
                            s0, s1 = sp["seg"]
                            for sx in range(s0, s1 + 1):
                                cols.append(pix[sx, py])
                        if cols:
                            ar = sum(c[0] for c in cols) / len(cols)
                            ag = sum(c[1] for c in cols) / len(cols)
                            ab = sum(c[2] for c in cols) / len(cols)
                        else:
                            ar, ag, ab = 180, 135, 90

                        appendages.append({
                            "name": f"Anse_Courbee_{side.capitalize()}",
                            "role": "curved_appendage_handle",
                            "primitive": "curved_sweep",
                            "path_points": path_3d,
                            "radius": round(tube_rad, 4),
                            "segments": 16,
                            "mean_rgb": (int(ar), int(ag), int(ab)),
                            "rationale": f"Appendice en arceau courbé détecté côté {side} (span={y_span}px, déviation={bulge:.1f}px) séparé du corps par un vide traversant.",
                            "confidence": 0.88,
                            "assumptions": ["Trajectoire coplanaire dans le plan XZ", "Section tubulaire circulaire constante"],
                            "uncertainties": ["Courbure hors-plan Y inaccessible sur vue monoculaire unique"]
                        })

        return appendages

    def synthesize_fashion_leather_components(self, decision=None, target_metric_height=0.20):
        """
        Synthèse géométrique et matérielle spécialisée pour les articles de maroquinerie / sacs.
        Harmonise le matériau cuir sur les surfaces du corps, modélise la dépouille et les angles adoucis,
        détecte la bouclerie métallique en façade et explicite les limites de vue monoculaire.
        Garantit qu'aucun fermoir ou anse n'est inventé s'il n'est pas soutenu par les pixels réels.
        """
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)
        pix = self.image.load()

        real_h = target_metric_height
        real_w = round(real_h / float(self.aspect_ratio), 4)
        real_d = round(real_w * 0.38, 4)

        # 1. Échantillonnage représentatif du cuir sur le corps (évite les extrêmes de reflet et d'ombre)
        leather_colors = []
        for y in range(int(min_y + bh * 0.20), int(min_y + bh * 0.80)):
            for x in range(int(min_x + bw * 0.15), int(min_x + bw * 0.85)):
                if self.mask[y][x]:
                    r, g, b = pix[x, y][:3]
                    if not (r > 235 and g > 235 and b > 235) and not (r < 30 and g < 30 and b < 30):
                        leather_colors.append((r, g, b))

        if leather_colors:
            r_m = sum(c[0] for c in leather_colors) / len(leather_colors)
            g_m = sum(c[1] for c in leather_colors) / len(leather_colors)
            b_m = sum(c[2] for c in leather_colors) / len(leather_colors)
        else:
            r_m, g_m, b_m = 177, 160, 142

        materials_decl = {
            "M_Cuir_Principal": {
                "custom": {
                    "base_color": [round(r_m / 255.0, 3), round(g_m / 255.0, 3), round(b_m / 255.0, 3), 1.0],
                    "roughness": 0.38,
                    "metallic": 0.0,
                    "specular_ior_level": 0.52,
                    "coat_weight": 0.12,
                    "coat_roughness": 0.25,
                    "sheen_weight": 0.20
                }
            },
            "M_Bouclerie_Laiton": {
                "preset": "brushed_brass_gold"
            }
        }

        # 2. Détection de la bouclerie / ferrure métallique dorée en façade
        gold_pts = []
        for y in range(min_y, max_y + 1):
            for x in range(min_x, max_x + 1):
                if self.mask[y][x]:
                    r, g, b = pix[x, y][:3]
                    if r > 160 and g > 130 and b < 120 and (r - b) > 40:
                        gold_pts.append((x, y))

        if len(gold_pts) > 100:
            avg_gx = sum(p[0] for p in gold_pts) / len(gold_pts)
            avg_gy = sum(p[1] for p in gold_pts) / len(gold_pts)
            rel_gx = (avg_gx - (min_x + bw / 2.0)) / float(bw)
            rel_gz = (max_y - avg_gy) / float(bh)
        else:
            rel_gx = 0.0
            rel_gz = 0.56

        clasp_x = round(rel_gx * real_w, 4)
        clasp_z = round(rel_gz * real_h, 4)
        clasp_y = -round(real_d * 0.50 + 0.002, 4)

        components = [
            {
                "id": "comp_1_corps_cuir",
                "name": "Corps_Principal_Cuir",
                "role": "main_body_core",
                "primitive": "rounded_box",
                "material": "M_Cuir_Principal",
                "dimensions": [round(real_w * 0.98, 4), round(real_d, 4), round(real_h * 0.68, 4)],
                "corner_radius": 0.035,
                "taper_ratio": 0.92,
                "bevel_width": 0.003,
                "location": [0.0, 0.0, 0.0],
                "relationship": {"type": "base_anchor", "target": None},
                "geometric_inference": {
                    "primitive_chosen": "rounded_box",
                    "selection_rationale": "Corps principal en maroquinerie sellier avec dépouille trapézoïdale et angles arrondis continus.",
                    "visual_cues": [f"Silhouette trapézoïdale évasée vers la base ({bw}px)", "Matériau cuir uniforme"],
                    "confidence_level": 0.94
                }
            },
            {
                "id": "comp_2_rabat_cuir",
                "name": "Rabat_Superieur_Cuir",
                "role": "top_flap_closure",
                "primitive": "rounded_box",
                "material": "M_Cuir_Principal",
                "dimensions": [round(real_w * 0.90, 4), round(real_d * 0.92, 4), round(real_h * 0.28, 4)],
                "corner_radius": 0.028,
                "taper_ratio": 0.88,
                "bevel_width": 0.003,
                "location": [0.0, 0.0, round(real_h * 0.68, 4)],
                "relationship": {"type": "stacked_on", "target": "comp_1_corps_cuir"},
                "geometric_inference": {
                    "primitive_chosen": "rounded_box",
                    "selection_rationale": "Rabat supérieur de fermeture prolongeant harmonieusement la silhouette du sac.",
                    "visual_cues": ["Continuité du cuir sur le quart supérieur", "Rétrécissement régulier du profil"],
                    "confidence_level": 0.92
                }
            }
        ]

        # Fermoir uniquement si prouvé par détection chromatique réelle
        if len(gold_pts) > 100:
            components.append({
                "id": "comp_3_fermoir_boucle",
                "name": "Fermoir_Boucle_Laiton",
                "role": "hardware_clasp_buckle",
                "primitive": "rounded_box",
                "material": "M_Bouclerie_Laiton",
                "dimensions": [0.045, 0.008, 0.026],
                "corner_radius": 0.005,
                "taper_ratio": 1.0,
                "bevel_width": 0.001,
                "location": [clasp_x, clasp_y, clasp_z],
                "relationship": {"type": "embedded_in_face", "target": "comp_1_corps_cuir"},
                "geometric_inference": {
                    "primitive_chosen": "rounded_box",
                    "selection_rationale": "Fermoir métallique central détecté par cluster chromatique doré dense en façade.",
                    "visual_cues": [f"Cluster de pixels dorés/laiton ({len(gold_pts)} px)", "Reflet métallique spéculaire"],
                    "confidence_level": 0.90
                }
            })

        # Anse uniquement si évidement interne traversant ou profil sommital compatible
        has_void = decision and decision["visual_metrics"].get("void_ratio", 0) > 0.08
        if has_void:
            arch_w = real_w * 0.32
            arch_top = real_h * 1.28
            arch_bot = real_h * 0.96
            path_pts = [
                [-round(arch_w, 4), 0.0, round(arch_bot, 4)],
                [-round(arch_w, 4), 0.0, round(arch_top * 0.90, 4)],
                [-round(arch_w * 0.5, 4), 0.0, round(arch_top, 4)],
                [0.0, 0.0, round(arch_top * 1.02, 4)],
                [round(arch_w * 0.5, 4), 0.0, round(arch_top, 4)],
                [round(arch_w, 4), 0.0, round(arch_top * 0.90, 4)],
                [round(arch_w, 4), 0.0, round(arch_bot, 4)]
            ]
            components.append({
                "id": "comp_4_anse_arche",
                "name": "Anse_Arche_Cuir",
                "role": "top_arch_handle",
                "primitive": "curved_sweep",
                "material": "M_Cuir_Principal",
                "path_points": path_pts,
                "radius": 0.007,
                "segments": 16,
                "location": [0.0, 0.0, 0.0],
                "relationship": {"type": "stacked_on", "target": "comp_2_rabat_cuir"},
                "geometric_inference": {
                    "primitive_chosen": "curved_sweep",
                    "selection_rationale": "Anse en arceau libre confirmée par détection d'évidement interne traversant sous l'anse.",
                    "visual_cues": [f"Évidement interne mesuré ({decision['visual_metrics']['void_pixels']} px)"],
                    "confidence_level": 0.95
                }
            })
        elif decision and decision["visual_metrics"].get("aspect_ratio", 1.0) > 0.95:
            components.append({
                "id": "comp_4_anse_superieure",
                "name": "Bande_Poignee_Superieure",
                "role": "top_handle_band",
                "primitive": "rounded_box",
                "material": "M_Cuir_Principal",
                "dimensions": [round(real_w * 0.65, 4), round(real_d * 0.35, 4), 0.016],
                "corner_radius": 0.012,
                "taper_ratio": 0.94,
                "bevel_width": 0.002,
                "location": [0.0, 0.0, round(real_h * 0.96, 4)],
                "relationship": {"type": "stacked_on", "target": "comp_2_rabat_cuir"},
                "geometric_inference": {
                    "primitive_chosen": "rounded_box",
                    "selection_rationale": "Anse et renfort sommital intégrés reposant sur le panneau supérieur sans jour traversant.",
                    "visual_cues": ["Contour supérieur renflé au centre", "Absence de vide traversant continu sous l'anse"],
                    "confidence_level": 0.88
                }
            })

        base_stem = os.path.splitext(os.path.basename(self.image_path))[0]
        if "." in base_stem:
            base_stem = os.path.splitext(base_stem)[0]

        total_z = round(arch_top * 1.02 + 0.007, 4) if has_void else round(real_h + 0.016, 4)
        spec = {
            "object_id": f"{base_stem}_spatial_decomposed",
            "object_name": f"{base_stem.replace('_', ' ').title()} Haute Maroquinerie",
            "category": "fashion_leather_goods",
            "scale_metric": {
                "unit": "meters",
                "dimensions": [round(real_w * 0.98, 4), real_d, total_z]
            },
            "coordinate_system": {
                "up_axis": "+Z",
                "forward_axis": "-Y",
                "lateral_axis": "+X",
                "origin": "bottom_center"
            },
            "materials": materials_decl,
            "components": components,
            "semantic_classification": decision,
            "analysis_metadata": {
                "source_image": self.image_path,
                "analyzer_module": "component_analyzer.py (Mission 36 Fashion Leather Engine)",
                "detected_strata_count": len(components),
                "total_components_generated": len(components),
                "confidence_score": decision.get("final_confidence", 0.93) if decision else 0.93,
                "contradiction_detected": decision.get("contradiction_detected", False) if decision else False,
                "is_fashion_leather": True,
                "leather_harmonization_applied": True,
                "hardware_accents_detected": len(gold_pts) > 100,
                "known_facts": [
                    f"Dimensions boîte englobante 2D : {bw}x{bh} px",
                    f"Ratio d'aspect mesuré : {self.aspect_ratio:.3f}",
                    f"Symétrie bilatérale mesurée : {self.base_analyzer.symmetry_score:.3f}",
                    "Matériau principal : Cuir maroquinerie unifié avec reflets PBR Principled BSDF",
                    f"Accessoire métallique doré détecté en façade ({len(gold_pts)} pixels)"
                ],
                "indeterminate_elements": [
                    "Profondeur Y et volume interne non visibles sur photo frontale unique, estimés selon les proportions standard de maroquinerie sellier."
                ],
                "hypotheses": [
                    "Décomposition volumique harmonisée : corps principal évasé + rabat supérieur fermant.",
                    "Unification du matériau cuir (M_Cuir_Principal) pour éviter la fragmentation luminance.",
                    "Compatibilité directe avec le composant React Product3DViewer de la boutique."
                ]
            }
        }
        self.log(f"Inférence maroquinerie : {len(components)} composants générés, cuir unifié, laiton ({len(gold_pts)} px)")
        return spec

    def synthesize_horizontal_lounge_components(self, decision=None, target_metric_height=0.85):
        """
        Synthèse géométrique pour le mobilier lounge / canapés horizontaux (Mission 36).
        Respecte la silhouette étalée (AR <= 0.55), décompose en châssis socle, assise coussins
        et dossier/accoudoirs, sans inventer d'anses ou ferrures invisibles.
        """
        min_x, min_y, max_x, max_y = self.bbox
        bw = max(1, max_x - min_x)
        bh = max(1, max_y - min_y)
        pix = self.image.load()

        real_h = target_metric_height
        real_w = round(real_h / float(self.aspect_ratio), 4)
        real_d = round(real_w * 0.46, 4)

        colors = []
        for y in range(int(min_y + bh * 0.35), int(min_y + bh * 0.85)):
            for x in range(int(min_x + bw * 0.20), int(min_x + bw * 0.80)):
                if self.mask[y][x]:
                    r, g, b = pix[x, y][:3]
                    if not (r > 240 and g > 240 and b > 240) and not (r < 25 and g < 25 and b < 25):
                        colors.append((r, g, b))

        if colors:
            r_m = sum(c[0] for c in colors) / len(colors)
            g_m = sum(c[1] for c in colors) / len(colors)
            b_m = sum(c[2] for c in colors) / len(colors)
        else:
            r_m, g_m, b_m = 185, 180, 175

        materials_decl = {
